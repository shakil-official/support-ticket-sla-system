APP_NAME="Support Desk"
APP_ENV=local
APP_KEY=base64:Vjz9ptlCdD/pascOMaOPV50DpcGqcX7uojVgtbdPOP8=
APP_DEBUG=true
APP_URL=http://localhost:8300
# Timestamps are STORED in UTC. Business-hour maths uses BUSINESS_TIMEZONE below.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Host ports published by docker-compose (change if they clash with other containers) ---
APP_PORT=8300
FORWARD_DB_PORT=3320
MAILPIT_PORT=8325

# --- Database (MySQL 8) ---------------------------------------------------
# Values below match docker-compose.yml. For a local (non-Docker) MySQL use DB_HOST=127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=support_desk
DB_USERNAME=support_desk
DB_PASSWORD=88c54859aa4a648ca97bb08f
# only used by docker-compose for the MySQL container
DB_ROOT_PASSWORD=3c1cc02b30a63dc77e650d71

# --- Redis: cache + queue -------------------------------------------------
# No Redis? set CACHE_STORE=database and QUEUE_CONNECTION=database (tables are migrated).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Must be larger than the CSV import job timeout (3600 s) or a second worker would pick up a running import.
REDIS_QUEUE_RETRY_AFTER=3700
SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# --- Mail (Mailpit in Docker: http://localhost:8325) -----------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ticketing ------------------------------------------------------------
TICKET_PREFIX=TKT
BUSINESS_TIMEZONE=Asia/Dhaka
TICKET_AUTO_ASSIGN=true
TICKET_AUTO_CLOSE_DAYS=3
